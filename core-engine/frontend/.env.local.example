# Frontend Next.js — Biến môi trường (BFF)
# HƯỚNG DẪN:
#   1. Sao chép: cp .env.local.example .env.local
#   2. Điền giá trị thực vào .env.local
#   3. TUYỆT ĐỐI không commit .env.local lên Git

# ─────────────────────────────────────────────
# NEXT-AUTH
# ─────────────────────────────────────────────
# URL public của Next.js app
NEXTAUTH_URL=http://localhost:3000

# Generate bằng: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# ─────────────────────────────────────────────
# KEYCLOAK OIDC (tạo Client trong Keycloak Admin UI)
# ─────────────────────────────────────────────
KEYCLOAK_CLIENT_ID=proteus-bff
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_GET_FROM_KEYCLOAK_UI

# Issuer = URL Realm của Keycloak (không có trailing slash)
KEYCLOAK_ISSUER=http://localhost:8080/realms/proteus

# ─────────────────────────────────────────────
# BACKEND (chỉ dùng server-side — không expose ra browser)
# ─────────────────────────────────────────────
# URL internal của FastAPI Backend (qua Docker network hoặc localhost)
BACKEND_URL=http://localhost:8000

# URL public của Mattermost Chat
NEXT_PUBLIC_MATTERMOST_URL=http://localhost:8065

# Outline Wiki Integration
NEXT_PUBLIC_OUTLINE_URL="http://docs.proteus.local"

# Files Manager Integration (Nextcloud / MinIO)
NEXT_PUBLIC_FILES_URL="http://files.proteus.local"
