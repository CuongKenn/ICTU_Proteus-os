{
  "_license": "Copyright (c) 2026 CuongKenn & ICTU Team | SPDX-License-Identifier: AGPL-3.0-or-later",
  "name": "CRM - Lead Capture",
  "nodes": [
    {
      "parameters": {
        "path": "crm/lead-capture",
        "responseMode": "lastNode",
        "options": {},
        "httpMethod": "POST"
      },
      "name": "Webhook - New Lead",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "crm-lead-capture-webhook"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO {{TENANT_SCHEMA}}.crm_leads (contact_name, company_name, email, phone, source, estimated_value, stage, assigned_to) VALUES ($1,$2,$3,$4,$5,$6,'NEW',$7) RETURNING id;",
        "options": {
          "queryReplacement": "={{$json.body.contact_name || $json.body.full_name}},={{$json.body.company_name || $json.body.company}},={{$json.body.email}},={{$json.body.phone}},={{$json.body.source}},={{$json.body.estimated_value}},={{$json.body.assigned_to}}"
        }
      },
      "name": "Insert Lead to DB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        450,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "ProteusDB_Real"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\": true, \"lead_id\": \"{{$('Insert Lead to DB').item.json.id}}\"}"
      },
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1050,
        300
      ]
    }
  ],
  "connections": {
    "Webhook - New Lead": {
      "main": [
        [
          {
            "node": "Insert Lead to DB",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Insert Lead to DB": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "crm"
    },
    {
      "name": "lead"
    }
  ]
}
