{
  "_license": "Copyright (c) 2026 CuongKenn & ICTU Team | SPDX-License-Identifier: AGPL-3.0-or-later",
  "name": "CRM - Customer Satisfaction Survey",
  "nodes": [
    {
      "parameters": {
        "path": "crm/satisfaction-survey",
        "responseMode": "lastNode",
        "options": {},
        "httpMethod": "POST"
      },
      "name": "Webhook - Survey Response",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "crm-satisfaction-webhook"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO {{TENANT_SCHEMA}}.crm_surveys (customer_id, opportunity_id, score, comment) VALUES ($1,$2,$3,$4);",
        "options": {
          "queryReplacement": "={{$json.body.customer_id}},={{$json.body.opportunity_id}},={{$json.body.score}},={{$json.body.comment}}"
        }
      },
      "name": "Save Survey",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        450,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "ProteusDB_Real"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$('Webhook - Survey Response').item.json.body.score}}",
              "operation": "smaller",
              "value2": 3
            }
          ]
        }
      },
      "name": "Low Score?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"success\": true}"
      },
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1050,
        400
      ]
    }
  ],
  "connections": {
    "Webhook - Survey Response": {
      "main": [
        [
          {
            "node": "Save Survey",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Survey": {
      "main": [
        [
          {
            "node": "Low Score?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Low Score?": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "crm"
    },
    {
      "name": "satisfaction"
    }
  ]
}
