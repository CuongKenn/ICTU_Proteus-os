{
  "_license": "Copyright (c) 2026 CuongKenn & ICTU Team | SPDX-License-Identifier: AGPL-3.0-or-later",
  "name": "CRM - Support Ticket Assignment",
  "nodes": [
    {
      "parameters": {
        "path": "crm/ticket-assignment",
        "responseMode": "lastNode",
        "options": {},
        "httpMethod": "POST"
      },
      "name": "Webhook - New Ticket",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "crm-ticket-assignment-webhook"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO {{TENANT_SCHEMA}}.crm_tickets (customer_id, title, description, priority, status, sla_deadline) VALUES ($1,$2,$3,$4,'OPEN', NOW() + INTERVAL '2 days') RETURNING id;",
        "options": {
          "queryReplacement": "={{$json.body.customer_id}},={{$json.body.title}},={{$json.body.description}},={{$json.body.priority}}"
        }
      },
      "name": "Create Ticket",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        850,
        200
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "ProteusDB_Real"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\": true, \"ticket_id\": \"{{$('Create Ticket').item.json.id}}\"}"
      },
      "name": "Respond OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    }
  ],
  "connections": {
    "Webhook - New Ticket": {
      "main": [
        [
          {
            "node": "Create Ticket",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Ticket": {
      "main": [
        [
          {
            "node": "Respond OK",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "crm"
    },
    {
      "name": "ticket"
    }
  ]
}
