{
  "_license": "Copyright (c) 2026 CuongKenn & ICTU Team | SPDX-License-Identifier: AGPL-3.0-or-later",
  "name": "CRM - Opportunity Follow-up",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 24
            }
          ]
        }
      },
      "name": "Schedule - Daily 8AM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, title, customer_id, stage, updated_at FROM {{TENANT_SCHEMA}}.crm_opportunities WHERE stage IN ('PROSPECTING','QUALIFICATION','PROPOSAL','NEGOTIATION') AND updated_at < NOW() - INTERVAL '3 days';",
        "options": {
          "queryReplacement": ""
        }
      },
      "name": "Find Stale Opportunities",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        450,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "ProteusDB_Real"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$items().length}}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "name": "Has Stale?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{json: {stale_count: $items().length}}];"
      },
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    }
  ],
  "connections": {
    "Schedule - Daily 8AM": {
      "main": [
        [
          {
            "node": "Find Stale Opportunities",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find Stale Opportunities": {
      "main": [
        [
          {
            "node": "Has Stale?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Stale?": {
      "main": [
        [
          {
            "node": "Summarize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "crm"
    },
    {
      "name": "follow-up"
    }
  ]
}
