{
  "_license": "Copyright (c) 2026 CuongKenn & ICTU Team | SPDX-License-Identifier: AGPL-3.0-or-later",
  "name": "Procurement - Vendor Evaluation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "cronExpression": "0 8 1 */3 *"
        }
      },
      "name": "Schedule - Quarterly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT v.id, v.name, COUNT(po.id) as total_orders, v.rating FROM {{TENANT_SCHEMA}}.procurement_vendors v LEFT JOIN {{TENANT_SCHEMA}}.procurement_contracts c ON c.vendor_id = v.id LEFT JOIN {{TENANT_SCHEMA}}.procurement_purchase_orders po ON po.contract_id = c.id GROUP BY v.id, v.name, v.rating;",
        "additionalFields": {}
      },
      "name": "Evaluate Vendors",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "name": "Split Vendors",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 2,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE {{TENANT_SCHEMA}}.procurement_vendors SET rating = $1, updated_at = NOW() WHERE id = $2;",
        "options": {
          "queryReplacement": "={{$json.rating || 5}},={{$json.id}}"
        }
      },
      "name": "Save Evaluation",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$json.avg_delay_days}}",
              "operation": "larger",
              "value2": 3
            }
          ]
        }
      },
      "name": "Poor Performance?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        1050,
        300
      ]
    },
    {
      "parameters": {
        "channelId": "={{$('Split Vendors').item.json.channel_id}}",
        "message": "=⚠️ **Nhà cung cấp giao hàng trễ liên tục**\nNhà cung cấp: {{$('Split Vendors').item.json.name}}\nSố đơn Q3: {{$('Split Vendors').item.json.total_orders}}\nTrễ trung bình: {{Math.round($('Split Vendors').item.json.avg_delay_days)}} ngày\nTổng giá trị: {{$('Split Vendors').item.json.total_spend}} VND\n\nĐề xuất đánh giá lại quan hệ với nhà cung cấp này."
      },
      "name": "Alert Poor Vendor",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1250,
        200
      ]
    }
  ],
  "connections": {
    "Schedule - Quarterly": {
      "main": [
        [
          {
            "node": "Evaluate Vendors",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluate Vendors": {
      "main": [
        [
          {
            "node": "Split Vendors",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split Vendors": {
      "main": [
        [
          {
            "node": "Save Evaluation",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Save Evaluation": {
      "main": [
        [
          {
            "node": "Poor Performance?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Poor Performance?": {
      "main": [
        [
          {
            "node": "Alert Poor Vendor",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "procurement"
    },
    {
      "name": "vendor"
    }
  ]
}
