{
  "_license": "Copyright (c) 2026 CuongKenn & ICTU Team | SPDX-License-Identifier: AGPL-3.0-or-later",
  "name": "Procurement - Purchase Order Approval",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "procurement/po-approval",
        "responseMode": "lastNode",
        "options": {}
      },
      "name": "Webhook - PO Approval",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "procurement-po-approval-webhook"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT po.id, po.total_amount, po.status, v.name as vendor_name FROM {{TENANT_SCHEMA}}.procurement_purchase_orders po LEFT JOIN {{TENANT_SCHEMA}}.procurement_contracts c ON c.id = po.contract_id LEFT JOIN {{TENANT_SCHEMA}}.procurement_vendors v ON v.id = c.vendor_id WHERE po.id = $1 AND po.status = 'pending';",
        "options": {
          "queryReplacement": "={{$json.body.po_id}}"
        }
      },
      "name": "Get PO Details",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE {{TENANT_SCHEMA}}.procurement_purchase_orders SET status = 'approved', updated_at = NOW() WHERE id = $1;",
        "options": {
          "queryReplacement": "={{$json.id}}"
        }
      },
      "name": "Submit PO",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT mattermost_user_id FROM users LIMIT 1;",
        "options": {
          "queryReplacement": ""
        }
      },
      "name": "Get Approver",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "userId": "={{$json.mattermost_user_id}}",
        "message": "=📄 **Đơn mua hàng cần phê duyệt**\nSố PO: {{$('Get PO Details').item.json.po_number}}\nNhà cung cấp: {{$('Get PO Details').item.json.vendor_name}}\nTổng giá trị: {{$('Get PO Details').item.json.total_amount}} {{$('Get PO Details').item.json.currency}}\nDựa trên PR: #{{$('Get PO Details').item.json.pr_id}}\n\n[✅ Phê duyệt PO](/api/procurement/po/approve?id={{$('Get PO Details').item.json.id}}) | [❌ Từ chối](/api/procurement/po/reject?id={{$('Get PO Details').item.json.id}})"
      },
      "name": "Notify Approver",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1050,
        300
      ]
    }
  ],
  "connections": {
    "Webhook - PO Approval": {
      "main": [
        [
          {
            "node": "Get PO Details",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get PO Details": {
      "main": [
        [
          {
            "node": "Submit PO",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Submit PO": {
      "main": [
        [
          {
            "node": "Get Approver",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Approver": {
      "main": [
        [
          {
            "node": "Notify Approver",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "procurement"
    },
    {
      "name": "purchase-order"
    }
  ]
}
