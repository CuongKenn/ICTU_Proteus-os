{
  "_license": "Copyright (c) 2026 CuongKenn & ICTU Team | SPDX-License-Identifier: AGPL-3.0-or-later",
  "name": "IT Helpdesk - Create Ticket",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "helpdesk/ticket/create",
        "responseMode": "lastNode",
        "options": {}
      },
      "name": "Webhook - New Ticket",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "helpdesk-create-ticket-webhook"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO {{TENANT_SCHEMA}}.it_tickets (requester_id, category_id, title, description, priority, status, sla_deadline, created_at) VALUES ($1,$2,$3,$4,$5,'OPEN', NOW() + CASE $5 WHEN 'P1' THEN INTERVAL '1 hour' WHEN 'P2' THEN INTERVAL '4 hours' WHEN 'P3' THEN INTERVAL '24 hours' ELSE INTERVAL '72 hours' END, NOW()) RETURNING id, sla_deadline;",
        "options": {
          "queryReplacement": "={{$json.body.requester_id}},={{$json.body.category_id}},={{$json.body.title}},={{$json.body.description}},={{$json.body.priority || 'P3'}}"
        }
      },
      "name": "Create Ticket with SLA",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT u.id as user_id, u.mattermost_user_id FROM users u LIMIT 1;",
        "options": {
          "queryReplacement": ""
        }
      },
      "name": "Auto-Assign Agent",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE {{TENANT_SCHEMA}}.it_tickets SET assignee_id = $1 WHERE id = $2;",
        "options": {
          "queryReplacement": "={{$json.user_id}},={{$('Create Ticket with SLA').item.json.id}}"
        }
      },
      "name": "Assign Ticket",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "userId": "={{$('Auto-Assign Agent').item.json.mattermost_user_id}}",
        "message": "=🎫 **Ticket IT mới được giao**\nID: #{{$('Create Ticket with SLA').item.json.id}}\nTiêu đề: {{$('Webhook - New Ticket').item.json.body.title}}\nDanh mục: {{$('Webhook - New Ticket').item.json.body.category}}\nMức độ: {{$('Webhook - New Ticket').item.json.body.priority}}\nSLA: {{$('Create Ticket with SLA').item.json.sla_deadline}}"
      },
      "name": "Notify Agent",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        1050,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={\"success\": true, \"ticket_id\": \"{{$('Create Ticket with SLA').item.json.id}}\", \"sla_deadline\": \"{{$('Create Ticket with SLA').item.json.sla_deadline}}\"}"
      },
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        1250,
        300
      ]
    }
  ],
  "connections": {
    "Webhook - New Ticket": {
      "main": [
        [
          {
            "node": "Create Ticket with SLA",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Ticket with SLA": {
      "main": [
        [
          {
            "node": "Auto-Assign Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Auto-Assign Agent": {
      "main": [
        [
          {
            "node": "Assign Ticket",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Assign Ticket": {
      "main": [
        [
          {
            "node": "Notify Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Notify Agent": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "helpdesk"
    },
    {
      "name": "ticket"
    }
  ]
}
