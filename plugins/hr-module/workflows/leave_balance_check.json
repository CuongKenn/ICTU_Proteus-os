{
  "_license": "Copyright (c) 2026 CuongKenn & ICTU Team | SPDX-License-Identifier: AGPL-3.0-or-later",
  "name": "HR - Annual Leave Balance Reset",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 1 1 1 *"
            }
          ]
        }
      },
      "name": "Cron (Jan 1st)",
      "type": "n8n-nodes-base.cron",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO {{TENANT_SCHEMA}}.hr_leave_balances (employee_id, year, remaining_days, tenant_id) SELECT id, extract(year from current_date), annual_leave_balance, tenant_id FROM {{TENANT_SCHEMA}}.hr_employees WHERE status = 'active' ON CONFLICT DO NOTHING;"
      },
      "name": "Reset Leave Balances",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "channelId": "hr-announcements-channel-id",
        "message": "🎉 **Thông báo:** Quỹ phép năm mới đã được cập nhật cho toàn bộ nhân viên. Chúc mọi người một năm làm việc hiệu quả!"
      },
      "name": "Notify General Channel",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    }
  ],
  "connections": {
    "Cron (Jan 1st)": {
      "main": [
        [
          {
            "node": "Reset Leave Balances",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Reset Leave Balances": {
      "main": [
        [
          {
            "node": "Notify General Channel",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {}
}
