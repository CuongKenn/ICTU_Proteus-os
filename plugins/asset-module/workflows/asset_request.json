{
  "_license": "Copyright (c) 2026 CuongKenn & ICTU Team | SPDX-License-Identifier: AGPL-3.0-or-later",
  "name": "Asset - Asset Request Workflow",
  "nodes": [
    {
      "parameters": {
        "path": "asset/request",
        "responseMode": "lastNode",
        "options": {},
        "httpMethod": "POST"
      },
      "name": "Webhook - Asset Request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "asset-request-webhook"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO {{TENANT_SCHEMA}}.asset_requests (asset_id, asset_type, requester_name, description, priority, status) VALUES ($1,$2,$3,$4,$5,'PENDING') RETURNING id;",
        "options": {
          "queryReplacement": "={{$json.body.asset_id}},={{$json.body.asset_type}},={{$json.body.requester_name || $json.body.requester_id}},={{$json.body.description}},={{$json.body.priority || 'P3'}}"
        }
      },
      "name": "Create Asset Request",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        450,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "ProteusDB_Real"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, code, name FROM {{TENANT_SCHEMA}}.asset_items WHERE id = $1 AND status = 'AVAILABLE';",
        "options": {
          "queryReplacement": "={{$('Webhook - Asset Request').item.json.body.asset_id}}"
        }
      },
      "name": "Check Available Asset",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        650,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "ProteusDB_Real"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.id}}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "name": "Asset Available?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        850,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const req = $('Create Asset Request').item.json;\nreturn [{json: {ok: false, reason: 'OUT_OF_STOCK', request_id: req.id || null}}];"
      },
      "name": "No Stock",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        650,
        500
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE {{TENANT_SCHEMA}}.asset_items SET status = 'ASSIGNED', updated_at = NOW() WHERE id = $1;",
        "options": {
          "queryReplacement": "={{$('Check Available Asset').item.json.id}}"
        }
      },
      "name": "Assign Item",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        1050,
        150
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "ProteusDB_Real"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO {{TENANT_SCHEMA}}.asset_assignments (asset_id, requester_name, dept_name, notes) VALUES ($1,$2,$3,$4);",
        "options": {
          "queryReplacement": "={{$('Check Available Asset').item.json.id}},={$('Webhook - Asset Request').item.json.body.requester_name || $('Webhook - Asset Request').item.json.body.requester_id},={$('Webhook - Asset Request').item.json.body.dept_name},={$('Webhook - Asset Request').item.json.body.description}"
        }
      },
      "name": "Record Assignment",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        1250,
        150
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "ProteusDB_Real"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE {{TENANT_SCHEMA}}.asset_requests SET status = 'APPROVED', assigned_asset_id = $1 WHERE id = $2;",
        "options": {
          "queryReplacement": "={{$('Check Available Asset').item.json.id}},={{$('Create Asset Request').item.json.id}}"
        }
      },
      "name": "Approve Request",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        1450,
        150
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "ProteusDB_Real"
        }
      }
    }
  ],
  "connections": {
    "Webhook - Asset Request": {
      "main": [
        [
          {
            "node": "Create Asset Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create Asset Request": {
      "main": [
        [
          {
            "node": "Check Available Asset",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Available Asset": {
      "main": [
        [
          {
            "node": "Asset Available?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Asset Available?": {
      "main": [
        [
          {
            "node": "Assign Item",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Stock",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Assign Item": {
      "main": [
        [
          {
            "node": "Record Assignment",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Record Assignment": {
      "main": [
        [
          {
            "node": "Approve Request",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "asset"
    },
    {
      "name": "request"
    }
  ]
}
