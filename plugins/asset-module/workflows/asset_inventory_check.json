{
  "_license": "Copyright (c) 2026 CuongKenn & ICTU Team | SPDX-License-Identifier: AGPL-3.0-or-later",
  "name": "Asset - Inventory Check",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 1 * *"
            }
          ]
        }
      },
      "name": "Schedule - Monthly",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, code, name, status FROM {{TENANT_SCHEMA}}.asset_items ORDER BY status, code;",
        "options": {
          "queryReplacement": ""
        }
      },
      "name": "Get All Assets",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        450,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "ProteusDB_Real"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO {{TENANT_SCHEMA}}.asset_inventory_snapshots (total_assets, by_status) VALUES ($1, $2::jsonb);",
        "options": {
          "queryReplacement": "={{$json.total_assets}},={{$json.by_status}}"
        }
      },
      "name": "Save Inventory Snapshot",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        650,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "ProteusDB_Real"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const rows = $items().map(i => i.json);\nconst byStatus = {};\nfor (const r of rows) { byStatus[r.status] = (byStatus[r.status] || 0) + 1; }\nreturn [{json: {total_assets: rows.length, by_status: JSON.stringify(byStatus)}}];"
      },
      "name": "Build Snapshot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    }
  ],
  "connections": {
    "Get All Assets": {
      "main": [
        [
          {
            "node": "Build Snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Snapshot": {
      "main": [
        [
          {
            "node": "Save Inventory Snapshot",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "asset"
    },
    {
      "name": "inventory"
    }
  ]
}
