{
  "_license": "Copyright (c) 2026 CuongKenn & ICTU Team | SPDX-License-Identifier: AGPL-3.0-or-later",
  "name": "Asset - Maintenance Schedule",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      },
      "name": "Schedule - Weekly Monday",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT i.code, i.name, m.type, m.next_due FROM {{TENANT_SCHEMA}}.asset_maintenance_logs m JOIN {{TENANT_SCHEMA}}.asset_items i ON i.id = m.asset_id WHERE m.next_due BETWEEN CURRENT_DATE AND CURRENT_DATE + INTERVAL '7 days' ORDER BY m.next_due;",
        "options": {
          "queryReplacement": ""
        }
      },
      "name": "Get This Week Maintenance",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [
        450,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "",
          "name": "ProteusDB_Real"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{$items().length}}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "name": "Has Schedule?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{json: {due_count: $items().length, items: $items().map(i => i.json)}}];"
      },
      "name": "Summarize",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        850,
        200
      ]
    }
  ],
  "connections": {
    "Schedule - Weekly Monday": {
      "main": [
        [
          {
            "node": "Get This Week Maintenance",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get This Week Maintenance": {
      "main": [
        [
          {
            "node": "Has Schedule?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has Schedule?": {
      "main": [
        [
          {
            "node": "Summarize",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "tags": [
    {
      "name": "asset"
    },
    {
      "name": "maintenance"
    }
  ]
}
