{
  "_license": "Copyright (c) 2026 CuongKenn & ICTU Team | SPDX-License-Identifier: AGPL-3.0-or-later",
  "name": "Document - Document Expiry Check",
  "nodes": [
    {
      "parameters": {
        "rule": {"cronExpression": "0 8 * * 1"}
      },
      "name": "Schedule - Weekly Monday",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT d.id, d.doc_code, d.title, d.expiry_date, d.assigned_to, d.tenant_id, cfg.channel_id FROM doc_documents d JOIN doc_config cfg ON cfg.tenant_id = d.tenant_id WHERE d.expiry_date BETWEEN CURRENT_DATE AND CURRENT_DATE + INTERVAL '30 days' AND d.status NOT IN ('ARCHIVED','CANCELLED') AND d.deleted_at IS NULL;",
        "additionalFields": {}
      },
      "name": "Find Expiring Docs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "number": [{"value1": "={{$items().length}}", "operation": "larger", "value2": 0}]
        }
      },
      "name": "Any Expiring?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "name": "Split Docs",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 2,
      "position": [850, 200]
    },
    {
      "parameters": {
        "channelId": "={{$json.channel_id}}",
        "message": "=⚠️ **Văn bản sắp hết hiệu lực**\nMã: {{$json.doc_code}}\nTiêu đề: {{$json.title}}\nHết hạn: {{$json.expiry_date}}\nPhụ trách: {{$json.assigned_to}}\n\nVui lòng gia hạn hoặc thanh lý văn bản này."
      },
      "name": "Alert Channel",
      "type": "n8n-nodes-base.mattermost",
      "typeVersion": 1,
      "position": [1050, 200]
    }
  ],
  "connections": {
    "Schedule - Weekly Monday": {"main": [[{"node": "Find Expiring Docs", "type": "main", "index": 0}]]},
    "Find Expiring Docs": {"main": [[{"node": "Any Expiring?", "type": "main", "index": 0}]]},
    "Any Expiring?": {"main": [[{"node": "Split Docs", "type": "main", "index": 0}]]},
    "Split Docs": {"main": [[{"node": "Alert Channel", "type": "main", "index": 0}]]}
  },
  "active": false,
  "settings": {"executionOrder": "v1"},
  "tags": [{"name": "document"}, {"name": "expiry"}]
}
