{
  "_license": "Copyright (c) 2026 CuongKenn & ICTU Team | SPDX-License-Identifier: AGPL-3.0-or-later",
  "realm": "proteus",
  "loginTheme": "proteus",
  "enabled": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 28800,
  "offlineSessionIdleTimeout": 2592000,
  "offlineSessionMaxLifespanEnabled": false,
  "offlineSessionMaxLifespan": 5184000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "superadmin",
        "description": "System Administrator",
        "composite": false
      },
      {
        "name": "tenant_admin",
        "description": "Tenant Administrator",
        "composite": false
      },
      {
        "name": "user",
        "description": "Normal User",
        "composite": false
      }
    ]
  },
  "defaultRole": {
    "name": "user"
  },
  "clients": [
    {
      "clientId": "proteus-bff",
      "name": "Proteus BFF",
      "description": "Next.js Frontend BFF",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "proteus-bff-secret",
      "redirectUris": [
        "http://localhost:3000/*",
        "https://localhost:3000/*",
        "http://localhost/*",
        "https://localhost/*",
        "https://${DOMAIN}/*",
        "http://${DOMAIN}/*"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "https://localhost:3000",
        "https://${DOMAIN}",
        "http://${DOMAIN}",
        "+"
      ],
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "frontchannel.logout.url": "",
        "post.logout.redirect.uris": "http://localhost:3000/*##https://localhost:3000/*##+"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "userinfo.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "proteus-bff",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "n8n",
      "name": "n8n Workflow Engine",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "n8n-secret",
      "redirectUris": [
        "http://localhost:5678/*",
        "https://localhost:5678/*",
        "https://workflow.${DOMAIN}/*",
        "http://workflow.${DOMAIN}/*"
      ],
      "webOrigins": [
        "http://localhost:5678",
        "https://workflow.${DOMAIN}",
        "http://workflow.${DOMAIN}",
        "+"
      ],
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "outline",
      "name": "Outline Wiki",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "outline-secret",
      "redirectUris": [
        "http://localhost:3002/*",
        "https://wiki.${DOMAIN}/*",
        "http://wiki.${DOMAIN}/*"
      ],
      "webOrigins": [
        "http://localhost:3002",
        "https://wiki.${DOMAIN}",
        "http://wiki.${DOMAIN}",
        "+"
      ],
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "appsmith",
      "name": "Appsmith Logic",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "appsmith-secret",
      "redirectUris": [
        "http://localhost:8080/*",
        "https://apps.${DOMAIN}/*",
        "http://apps.${DOMAIN}/*"
      ],
      "webOrigins": [
        "http://localhost:8080",
        "https://apps.${DOMAIN}",
        "http://apps.${DOMAIN}",
        "+"
      ],
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    },
    {
      "clientId": "mattermost",
      "name": "Mattermost Chat",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "mattermost-secret",
      "redirectUris": [
        "http://chat.proteus.local/signup/gitlab/complete"
      ],
      "webOrigins": [
        "http://chat.proteus.local"
      ],
      "publicClient": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "gitlab-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "mattermostId",
            "claim.name": "id",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "gitlab-username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "username",
            "claim.name": "username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "gitlab-email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ],
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "metabase",
      "name": "Metabase BI",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "metabase-secret",
      "redirectUris": [
        "http://localhost:3001/*",
        "https://analytics.${DOMAIN}/*",
        "http://analytics.${DOMAIN}/*"
      ],
      "webOrigins": [
        "http://localhost:3001",
        "https://analytics.${DOMAIN}",
        "http://analytics.${DOMAIN}",
        "+"
      ],
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "protocol": "openid-connect"
    }
  ],
  "clientScopes": [
    {
      "name": "openid",
      "description": "OpenID Connect built-in scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "sub",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "role_list",
      "description": "SAML role list",
      "protocol": "saml",
      "attributes": {
        "consent.screen.text": "${samlRoleListScopeConsentText}",
        "display.on.consent.page": "true"
      }
    },
    {
      "name": "email",
      "description": "OpenID Connect built-in scope: email",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.page": "true",
        "gui.order": "200",
        "consent.screen.text": "${emailScopeConsentText}"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        },
        {
          "name": "email verified",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "emailVerified",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email_verified",
            "jsonType.label": "boolean"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "OpenID Connect built-in scope: profile",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.page": "true",
        "gui.order": "300",
        "consent.screen.text": "${profileScopeConsentText}"
      },
      "protocolMappers": [
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-property-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "tenant",
      "description": "Tenant Scope",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.page": "true"
      },
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": [
    "role_list",
    "profile",
    "email",
    "tenant",
    "openid"
  ],
  "users": [
    {
      "username": "admin",
      "email": "admin@proteus.local",
      "firstName": "Proteus",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin@123",
          "temporary": true
        }
      ],
      "realmRoles": [
        "superadmin",
        "user"
      ],
      "attributes": {
        "tenant_id": [
          "default"
        ]
      }
    }
  ]
}
