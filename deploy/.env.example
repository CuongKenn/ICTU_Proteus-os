#
# Proteus OS — Biến môi trường (Environment Variables)
# HƯỚNG DẪN:
#   1. Sao chép file này: cp .env.example .env
#   2. Điền GIÁ TRỊ THỰC vào file .env
#   3. TUYỆT ĐỐI không commit file .env lên Git
#   4. Mọi giá trị còn "CHANGE_ME" đều BẮT BUỘC phải thay đổi

# ─────────────────────────────────────────────
# DOMAIN
# ─────────────────────────────────────────────
# Domain gốc của hệ thống (không có http://)
# Tất cả subdomain được tạo tự động từ biến này:
#   auth.DOMAIN    → Keycloak
#   api.DOMAIN     → Backend FastAPI (qua Traefik)
#   wiki.DOMAIN    → Outline
#   analytics.DOMAIN → Metabase
#   apps.DOMAIN    → Appsmith
#   workflow.DOMAIN → n8n
DOMAIN=proteus.local

# ─────────────────────────────────────────────
# DEPLOY MODE (do setup.sh / setup.ps1 tự điền — không cần sửa tay)
# ─────────────────────────────────────────────
# APP_MODE: local (máy dev, proteus.local + HTTP) hoặc production (VPS + HTTPS)
APP_MODE=local
# PUBLIC_SCHEME: http (local) hoặc https (production). Tự lan ra mọi URL
# trình duyệt (NEXT_PUBLIC_*, MB_SITE_URL, Keycloak, n8n, Outline...).
PUBLIC_SCHEME=http
# COMPOSE_FILE: local chỉ dùng docker-compose.yml; production cộng thêm
# docker-compose.prod.yml (TLS Let's Encrypt + redirect HTTP→HTTPS).
COMPOSE_FILE=docker-compose.yml
# Email nhận thông báo hết hạn chứng chỉ Let's Encrypt (chỉ production).
LETSENCRYPT_EMAIL=admin@example.com
# Host port map ra Traefik (container 80/443). Đổi khi bị trùng app khác
# trên cùng máy (VD: 443 bận → HTTPS_PORT=8443). Port 80 của host BẮT BUỘC
# trống để Let's Encrypt HTTP challenge hoạt động (chỉ production).
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443
# Hậu tố port gắn vào mọi URL public. Để trống với port chuẩn (http+80,
# https+443); setup script tự điền (VD: ":8443") khi port lệch chuẩn.
PUBLIC_URL_SUFFIX=
# Production: true / true / https / true — setup script tự đổi.
OUTLINE_FORCE_HTTPS=false
N8N_PROTOCOL=http
N8N_SECURE_COOKIE=false

# ─────────────────────────────────────────────
# ENVIRONMENT
# ─────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
# Cấu hình Docker Compose Profiles. Sử dụng để quyết định xem module phụ nào được chạy.
# Ví dụ: "ollama" để chạy local ollama, "vllm" để chạy vLLM (yêu cầu GPU).
COMPOSE_PROFILES=

# Danh sách origin được phép gọi Backend API (CORS). Format JSON array.
# Thêm domain thực khi deploy lên staging/production.
# plugins.${DOMAIN}: Micro-Frontend gateway gọi trực tiếp khi cần.
ALLOWED_ORIGINS=["http://localhost:3000","http://proteus.local","http://plugins.proteus.local","https://proteus.local","https://plugins.proteus.local"]

# ─────────────────────────────────────────────
# POSTGRESQL
# ─────────────────────────────────────────────
POSTGRES_DB=proteus
POSTGRES_USER=proteus
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE

# ─────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD_HERE

# ─────────────────────────────────────────────
# KEYCLOAK
# ─────────────────────────────────────────────
# Development: start-dev (default)
# Production: start (TLS terminates at Traefik; Keycloak serves plain HTTP on :8080).
# Do NOT use `start --optimized` with the stock image: it requires a prior
# `kc.sh build` and exits 2 ("build the server first") on first boot.
KEYCLOAK_START_MODE=start-dev
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD_HERE
KEYCLOAK_REALM=proteus

# Client của Next.js BFF (tạo trong Keycloak Admin UI)
KEYCLOAK_BFF_CLIENT_ID=proteus-bff
KEYCLOAK_BFF_CLIENT_SECRET=CHANGE_ME_GET_FROM_KEYCLOAK_UI
# URL nội bộ Docker cho server-side token/JWKS calls (thường là http://keycloak:8080)
KEYCLOAK_INTERNAL_URL=http://keycloak:8080

# ─────────────────────────────────────────────
# NEXT.JS (BFF / Frontend)
# ─────────────────────────────────────────────
# Đường dẫn kết nối đến Backend FastAPI (dành cho BFF proxy)
# Nếu chạy trong Docker, thường là http://backend:8000
BACKEND_URL=http://localhost:8000
# Generate bằng lệnh: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL

# ─────────────────────────────────────────────
# N8N
# ─────────────────────────────────────────────
# Generate bằng lệnh: openssl rand -hex 32
N8N_ENCRYPTION_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL
# Tạo API Key trong n8n Settings sau khi cài
N8N_API_KEY=CHANGE_ME_GET_FROM_N8N_SETTINGS

# ─────────────────────────────────────────────
# METABASE
# ─────────────────────────────────────────────
METABASE_URL=http://metabase:3000
# Secret ký JWT cho static embedding (dashboard nhúng trong Launchpad).
# Tự sinh bởi setup.sh/setup.ps1. Lấy đúng giá trị này đối chiếu với
# Admin → Embedding trong Metabase UI sau khi setup.
METABASE_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL
# METABASE_EMBEDDING_KEY: Chỉ dùng cho Metabase Enterprise (trả phí).
# Bản OSS dùng Public Embedding + Row-Level Security — không cần biến này.

# ─────────────────────────────────────────────
# MATTERMOST
# ─────────────────────────────────────────────
MATTERMOST_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE_123
MATTERMOST_URL=http://mattermost:8065
# Token của Bot User trong Mattermost
MATTERMOST_BOT_TOKEN=CHANGE_ME_GET_FROM_MATTERMOST
# Secret dùng để verify request từ Mattermost Slash Commands
MATTERMOST_WEBHOOK_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL
# Kênh hệ thống mặc định — kênh fallback cho thông báo gỡ plugin, AI command,
# timeout worker khi tenant chưa có kênh riêng (lấy ID trong Mattermost >
# View Info). Để trống = tắt thông báo hệ thống.
MATTERMOST_SYSTEM_CHANNEL_ID=CHANGE_ME_GET_FROM_MATTERMOST

# ─────────────────────────────────────────────
# APPSMITH
# ─────────────────────────────────────────────
APPSMITH_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
APPSMITH_URL=http://appsmith:80
# API Key tạo trong Appsmith (Developer Settings)
APPSMITH_API_KEY=CHANGE_ME_GET_FROM_APPSMITH
# OIDC Client "appsmith" trong Keycloak (secret đồng bộ tự động bởi setup.sh
# từ realm-import.json / Keycloak Admin API; để placeholder để script tự điền)
APPSMITH_OIDC_SECRET=CHANGE_ME_GET_FROM_KEYCLOAK_UI
# OIDC Client "n8n" trong Keycloak (dự phòng khi bật SSO cho n8n)
N8N_OIDC_SECRET=CHANGE_ME_GET_FROM_KEYCLOAK_UI
# GRAFANA
# ─────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ─────────────────────────────────────────────
# OUTLINE (Wiki)
# ─────────────────────────────────────────────
OUTLINE_SECRET_KEY=5b951e0523364470a48906b4603b62f82ec9b91ba72f4e2bb595ede82f2ae739
OUTLINE_UTILS_SECRET=f4b48712d3a248e79ed9975038da9d7c86a0ee2195ab4a6aa4dcaa2b517d2749
# OIDC Client "outline" cần tạo trong Keycloak Admin UI
OUTLINE_OIDC_SECRET=CHANGE_ME_GET_FROM_KEYCLOAK_UI

# ─────────────────────────────────────────────
# LOCAL LLM (AI Orchestrator)
# ─────────────────────────────────────────────
# Hệ thống Proteus OS chỉ hỗ trợ Local LLM (vLLM / Ollama) vì lý do Data Privacy
LLM_PROVIDER=local_llm
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL_NAME=llama3
LLM_API_KEY=dummy

# ─────────────────────────────────────────────
# BACKUP & DISASTER RECOVERY
# ─────────────────────────────────────────────
BACKUP_DIR=./backups/postgres
BACKUP_RETENTION_DAYS=7
MATTERMOST_WEBHOOK_URL=http://mattermost:8065/hooks/CHANGE_ME

# ─────────────────────────────────────────────
# FRONTEND EXTERNAL SERVICES (Client-side exposed)
# Dev dùng http (Traefik entrypoint :80). Subdomain phải khớp Traefik rules:
# chat=mattermost, wiki=outline, workflow=n8n, analytics=metabase, apps=appsmith
# ─────────────────────────────────────────────
NEXT_PUBLIC_MATTERMOST_URL=http://chat.proteus.local
NEXT_PUBLIC_OUTLINE_URL=http://wiki.proteus.local
NEXT_PUBLIC_N8N_URL=http://workflow.proteus.local
NEXT_PUBLIC_METABASE_URL=http://analytics.proteus.local
NEXT_PUBLIC_APPSMITH_URL=http://apps.proteus.local

# ─────────────────────────────────────────────
# PLUGIN MICRO-FRONTEND GATEWAY (server-side)
# Base URL public của gateway plugins.<domain> — backend dùng để dựng
# external_url cho plugin (ghi đè host local hardcode trong manifest.yaml).
# setup.sh tự điền theo mode (local: http://plugins.proteus.local,
# production: $PUBLIC_SCHEME://plugins.$DOMAIN$URL_SUFFIX).
# ─────────────────────────────────────────────
PLUGINS_MFE_URL=http://plugins.proteus.local

# ─────────────────────────────────────────────
# SMTP / EMAIL (Keycloak gửi email mời nhân viên)
# ─────────────────────────────────────────────
# Cấu hình này được dùng bởi Keycloak để gửi email:
#   - Email mời nhân viên đặt mật khẩu (POST /api/v1/users/invite)
#   - Email xác minh tài khoản
#   - Email reset mật khẩu
#
# Cách áp dụng: Sau khi deploy, vào Keycloak Admin → proteus realm
# → Realm Settings → Email → điền thông tin dưới đây.
#
# Với Gmail: Bật "App Password" tại https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_DISPLAY_NAME=Proteus OS
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=CHANGE_ME_YOUR_APP_PASSWORD
